{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E.V",
  "version": "1.0.1",
  "identifier": "com.ducknac.ev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "title": "E.V",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "E.V Release Signing",
      "hardenedRuntime": false
    },
    "resources": {
      "resources/libgideoncapture.dylib": "libgideoncapture.dylib"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCOTNGQjlBQTQyNENGNTUKUldSVnp5U2ttdnVUMngrNzBBdGZQOWFYcnJjRjBNcmZCb1VtUlg4UFdKbmNLYm0xakora1JJQ28K",
      "endpoints": [
        "https://github.com/Ducknac999/ev/releases/latest/download/latest.json"
      ]
    }
  }
}