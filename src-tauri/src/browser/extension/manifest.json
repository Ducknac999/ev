{
  "manifest_version": 3,
  "name": "E.V",
  "version": "1.0.0",
  "description": "Lets E.V, the assistant on your Mac, read and change web pages when you ask it to. Talks only to E.V on this Mac.",
  "permissions": ["scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["config.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": { "id": "__GECKO_ID__", "strict_min_version": "121.0" }
  }
}
